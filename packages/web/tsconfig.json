{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@img/*": ["./src/assets/images/*"]
    }
  },
  "include": ["src", "vite.config.mts", "vite/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/entry.server.tsx", "src/sw.ts"]
}
