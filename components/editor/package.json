{
  "name": "@q673115816/editor",
  "version": "0.0.1",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "author": "q673115816",
  "sideEffects": false,
  "license": "APGL",
  "repository": {
    "type": "git",
    "url": "https://github.com/q673115816/react-wyy-music-pc.git",
    "directory": "components/editor"
  },
  "homepage": "https://github.com/q673115816/react-wyy-music-pc/tree/master/components/editor",
  "bugs": "https://github.com/q673115816/react-wyy-music-pc/issues",
  "keywords": [
    "typescript",
    "react",
    "editor"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf lib esm umd dist",
    "start:ts": "tsc --watch",
    "build:cjs": "tsc",
    "build:es": "tsc -m esNext --outDir esm",
    "build:ts": "npm run build:cjs && npm run build:es",
    "build": "tsup",
    "start": "tsup --watch",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint src",
    "release": "npm run build && npm publish"
  },
  "dependencies": {
    "react-use": "^17.6.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.1.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
