{
  "name": "wyy",
  "version": "1.0.0",
  "private": true,
  "description": "React music player",
  "keywords": [
    "react"
  ],
  "homepage": "https://neteasecloudmusic.fun",
  "bugs": {
    "url": "https://github.com/q673115816/react-wyy-music-pc/issues",
    "email": "673115816@qq.com"
  },
  "license": "AGPL-3.0",
  "author": {
    "name": "linjinjun",
    "email": "673115816@qq.com"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.js",
    "ncu:all": "pnpm -r exec ncu -u",
    "build": "pnpm -r build",
    "update": "pnpm -r up --latest",
    "clean": "pnpm -r clean",
    "rm": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "view": "pnpm -rc exec pnpm view $PNPM_PACKAGE_NAME",
    "web:dev": "pnpm start -C packages/web",
    "web:build": "pnpm -r build --filter @wyy/web",
    "start": "pnpm --parallel -r start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "commit": "git-cz"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
